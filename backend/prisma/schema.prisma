datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int          @id @default(autoincrement())
  username         String       @unique
  email            String       @unique
  password         String
  firstName        String?
  lastName         String?
  role             String       @default("DEVELOPER")
  createdAt        DateTime     @default(now())
  createdTeams     Team[]       @relation("TeamCreator")
  pendingApprovals Team[]       @relation("TeamPendingApprover")
  members          TeamMember[]
  comments         Comment[]
  createdInvites   TeamInvite[]
}

enum TeamRole {
  TEAM_LEADER // ראש צוות
  PRODUCT_MANAGER // מנהל מוצר
  TESTER // בודק
  DEVELOPER // מפתח
  DEVOPS // DevOps
}

enum TeamStatus {
  PENDING_APPROVAL
  ACTIVE
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

model Team {
  id                Int          @id @default(autoincrement())
  name              String
  mainOffice        String?
  status            TeamStatus   @default(PENDING_APPROVAL)
  createdAt         DateTime     @default(now())
  creatorId         Int
  pendingApproverId Int?
  creator           User         @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  pendingApprover   User?        @relation("TeamPendingApprover", fields: [pendingApproverId], references: [id], onDelete: SetNull)
  members           TeamMember[]
  comments          Comment[]
  sprints           Sprint[]
  invites           TeamInvite[]
}

model TeamInvite {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  teamId      Int
  name        String? // admin-facing label for a generic link, e.g. "לינק לצוות פיתוח"
  email       String? // set = personal invite locked to this address; null = generic link
  role        TeamRole  @default(DEVELOPER)
  createdById Int
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model TeamMember {
  id        Int               @id @default(autoincrement())
  userId    Int
  teamId    Int
  role      TeamRole          @default(DEVELOPER)
  isAdmin   Boolean           @default(false)
  status    TeamMemberStatus  @default(ACTIVE)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

enum CommentType {
  KEEP
  IMPROVE
}

enum CommentCategory {
  SPRINT_SETUP
  PRE_PLANNING
  PLANNING
  ONGOING_WORK
  TESTING
  AVAILABILITY
  ESTIMATIONS
  SPECIFICATIONS
  TASK_DISTRIBUTION
  PERSONAL
  FUN
  GENERAL
  TECHNICAL
}

model Sprint {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  teamId      Int
  createdAt   DateTime @default(now())

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  comments Comment[]
}

model Comment {
  id          Int              @id @default(autoincrement())
  content     String
  type        CommentType
  category    CommentCategory?
  isAnonymous Boolean          @default(false)
  createdAt   DateTime         @default(now())
  authorId    Int
  teamId      Int
  sprintId    Int

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}
