datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        Int                        @id @default(autoincrement())
  username                  String                     @unique
  // Feature 7 (2026-09-07, decision #3): intentionally NOT @unique anymore. Signing in with
  // Google can attach `googleId` to (or create a fresh row for) a user whose email already
  // matches another existing `User` row — that email-collision case is explicitly deferred,
  // not solved (see PRODUCT-BACKLOG.md §7.0/"לא בטיפול"), so two rows may transiently share an
  // email. Do not re-add @unique here without resolving that decision first.
  email                     String
  // Feature 7: nullable because a user created directly via Google sign-in has no password at
  // all (`password: null`), permanently and by design — not a transitional state. See
  // AuthService.login's explicit null-password guard and PRODUCT-BACKLOG.md §7.0 default #4.
  password                  String?
  // Feature 7: Google's `sub` claim — the stable identifier for "same Google account returns",
  // deliberately not relying on email comparisons alone for that (see PRODUCT-BACKLOG.md §7.0
  // default #3).
  googleId                  String?                    @unique
  // Feature 7 addendum (2026-09-11, §7.4): timestamp for "we have real external proof this
  // email belongs to this user" (Google sign-in linked/created this row with this exact
  // email) — not an enforcement/gating flag, nothing reads this to block anything. Reset to
  // null whenever the email actually changes to an address that hasn't been proven. Separate
  // from, and does not touch, the deferred email-collision decision above.
  emailVerifiedAt           DateTime?
  firstName                 String?
  lastName                  String?
  role                      String                     @default("DEVELOPER")
  // Feature 9 (phantom members, product-backlog/09-phantom-members.md §9.0 decision #1): a
  // phantom is a real `User` row (password: null, no googleId) standing in for a real person who
  // won't register. `TeamMember.userId`/`Comment.authorId` are deliberately left untouched — a
  // phantom is a `TeamMember`/comment author like any other, this flag is purely informational.
  isPhantom                 Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  createdTeams              Team[]                     @relation("TeamCreator")
  deletedTeams              Team[]                     @relation("TeamDeletedBy")
  deletedSprints            Sprint[]                   @relation("SprintDeletedBy")
  pendingApprovals          Team[]                     @relation("TeamPendingApprover")
  members                   TeamMember[]
  comments                  Comment[]                  @relation("CommentAuthor")
  commentsPostedAsAdmin     Comment[]                  @relation("CommentPostedByAdmin")
  createdInvites            TeamInvite[]
  googleCalendarConnections GoogleCalendarConnection[]
  sprintLengthChanges       SprintLengthChange[]
  createdCommentCategories  TeamCommentCategory[]      @relation("TeamCommentCategoryCreator")
  messagingLinks            UserMessagingLink[]
  createdFocusPoints        FocusPoint[]               @relation("FocusPointCreator")
  focusPointTextChanges     FocusPointTextVersion[]    @relation("FocusPointTextChanger")
  focusPointProposals       FocusPointProposal[]
  focusPointSelections      FocusPointSprint[]
  focusPointRatings         FocusPointRating[]
  sprintRatingCloses        SprintRatingClose[]
  assignedFocusPointTasks   FocusPointTask[]           @relation("FocusPointTaskAssignee")
  createdFocusPointTasks    FocusPointTask[]           @relation("FocusPointTaskCreator")
  onboardingState           UserOnboardingState?
}

// Feature 21 (product-backlog/21-onboarding-and-feature-discovery.md §21.0 default #2): UI state
// only — whether the getting-started checklist was dismissed, and which "what's new" feature keys
// the user has already seen. Checklist progress is deliberately NOT stored: it is derived from
// existing data on every `GET /onboarding/status`. The row is created lazily (first write), so no
// backfill is needed for existing users. 1:1 with User, cascade on delete.
model UserOnboardingState {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  checklistDismissedAt DateTime?
  seenFeatureKeys      String[]  @default([])
  // Feature 22: when the interactive guide was auto-opened for a brand-new user (once, across devices).
  guideAutoStartedAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Feature 10 (telegram comment ingestion, product-backlog/10-telegram-comment-ingestion.md §10.0
// decision #2 + default #1): generic per-channel identity link — deliberately NOT a
// `telegramChatId` column on `User` — so a future WhatsApp adapter (`channel: WHATSAPP`) can reuse
// the exact same resolve/conversation logic against the same model. Built on the closest existing
// shape, `GoogleCalendarConnection` ("personal connection to an external identity, soft-revoke
// instead of hard delete" — not the `TeamInvite`/per-team-owned-entity pattern, since this isn't
// team-scoped). Also carries conversation *state*, not just identity: `activeTeamId`/
// `activeSprintId` are the "sticky, no time-based expiry" active team+sprint context (§10.0
// decision #5); `pendingCommentContent`/`pendingCommentType` hold the in-progress comment body
// while waiting on the Keep/Improve + category round-trip (§10.0 decision #6);
// `lastProcessedUpdateId` is the webhook idempotency guard against Telegram's at-least-once
// delivery retries (notably right after a Fly suspend/resume, §10.0 default #8/#9).
enum MessagingChannel {
  TELEGRAM
}

model UserMessagingLink {
  id                     Int              @id @default(autoincrement())
  userId                 Int
  channel                MessagingChannel
  externalId             String
  isRevoked              Boolean          @default(false)
  activeTeamId           Int?
  activeSprintId         Int?
  pendingCommentContent  String?
  pendingCommentType     CommentType?
  lastProcessedUpdateId  Int?
  linkedAt               DateTime         @default(now())
  // Team/sprint context stickiness (Nave's explicit ask, 2026-09-27 — supersedes the earlier
  // "no time-based expiry" decision in product-backlog/10-*.md §10.0 #5). `contextSetAt` is
  // refreshed whenever activeTeamId/activeSprintId is (re)confirmed; `contextStickyHours` is a
  // per-link, user-configurable duration (null = never expire, back to the original behavior) —
  // configured via `PATCH /auth/telegram/link/settings`.
  contextSetAt           DateTime?
  contextStickyHours     Int?             @default(24)
  // Set only by an explicit "↩️ חזור" from the Keep/Improve stage back to team/sprint selection —
  // forces an explicit re-ask even when there's only one team/sprint candidate (normally silent),
  // so the user can confirm or change it. Cleared once team+sprint are both resolved again.
  awaitingContextConfirm Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
}

enum TeamRole {
  TEAM_LEADER // ראש צוות
  PRODUCT_MANAGER // מנהל מוצר
  TESTER // בודק
  DEVELOPER // מפתח
  DEVOPS // DevOps
}

enum TeamStatus {
  PENDING_APPROVAL
  ACTIVE
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

model Team {
  id                Int                          @id @default(autoincrement())
  name              String
  mainOffice        String?
  status            TeamStatus                   @default(PENDING_APPROVAL)
  createdAt         DateTime                     @default(now())
  creatorId         Int
  pendingApproverId Int?
  creator           User                         @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  pendingApprover   User?                        @relation("TeamPendingApprover", fields: [pendingApproverId], references: [id], onDelete: SetNull)
  members           TeamMember[]
  comments          Comment[]
  sprints           Sprint[]
  invites           TeamInvite[]
  googleCalendars   GoogleCalendarTeamCalendar[]
  commentCategories TeamCommentCategory[]
  focusPoints       FocusPoint[]
  // Feature 20 §20.0 decision #10: how many improvement points management may select per sprint.
  focusPointQuota   Int                          @default(3)
  // Feature 19 (team logo, product-backlog/19-team-logo.md §19.0): the image bytes live in
  // `TeamLogo` so every query that includes `Team` doesn't drag a blob along. `logoUpdatedAt`
  // doubles as "has a logo" (null = none) and the cache-buster in the logo URL; `accentHue`
  // (0-359, null = no team colour) is the dominant hue the client extracted from the logo.
  logoUpdatedAt     DateTime?
  accentHue         Int?
  logo              TeamLogo?
  // Feature 14: soft delete (see Sprint.deletedAt). `TeamMember` rows are NOT touched by a soft
  // delete — they are how "teams I can restore" knows who was an admin at the moment of deletion.
  deletedAt         DateTime?
  deletedById       Int?
  deletedBy         User?                        @relation("TeamDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

// Feature 19: 1:1 with Team, normalised client-side to a 256x256 PNG (PNG/JPEG only, <=512KB).
model TeamLogo {
  id          Int      @id @default(autoincrement())
  teamId      Int      @unique
  data        Bytes
  contentType String
  updatedAt   DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// Feature 3 (team comment categories, product-backlog/03-team-comment-categories.md §3.0): built
// on the same shape as `TeamInvite` (see backend/AGENTS.md's "per-team-owned entities" pattern) —
// `teamId` FK cascade, a boolean soft-disable flag instead of a hard delete (§3.0 decision #3).
// `isDefault` distinguishes the 13 auto-seeded rows (every team gets these, see
// teams.service.ts::create and scripts/backfill-team-comment-categories.js for pre-existing
// teams) from admin/team-leader-created custom ones — both are disabled the same way, never
// deleted, so old comments never lose their category label. `createdById` is null for the 13
// seeded defaults (nobody "created" them) and set for a custom category.
model TeamCommentCategory {
  id          Int      @id @default(autoincrement())
  teamId      Int
  label       String
  isDefault   Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("TeamCommentCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments  Comment[]
}

model TeamInvite {
  id               Int       @id @default(autoincrement())
  token            String    @unique
  teamId           Int
  name             String? // admin-facing label for a generic link, e.g. "לינק לצוות פיתוח"
  email            String? // set = personal invite locked to this address; null = generic link
  role             TeamRole  @default(DEVELOPER)
  createdById      Int
  expiresAt        DateTime?
  maxUses          Int?
  useCount         Int       @default(0)
  isRevoked        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  // Feature 9 (phantom members, §9.0 decision #3): when set, this invite is a one-time
  // phantom -> real-account conversion link, not a regular join link — consumed via a separate
  // `consumePhantomConversionInvite` flow (`invites.service.ts`), never `consumeInvite`.
  convertsMemberId Int?

  team           Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy      User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  convertsMember TeamMember? @relation(fields: [convertsMemberId], references: [id], onDelete: Cascade)
}

// Personal Google Calendar connection — one per user (not per team, see
// PRODUCT-BACKLOG.md §6.0.2). Built on the same shape as `TeamInvite`: FK cascade to the
// owning entity, a soft-revoke flag instead of a hard delete on disconnect.
model GoogleCalendarConnection {
  id                 Int      @id @default(autoincrement())
  userId             Int
  accessToken        String
  refreshToken       String
  expiresAt          DateTime
  googleAccountEmail String
  isRevoked          Boolean  @default(false)
  createdAt          DateTime @default(now())

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        SprintGoogleEvent[]
  teamCalendars GoogleCalendarTeamCalendar[]
}

// One dedicated (secondary, non-primary) Google Calendar per (connection, team) — created lazily
// on first sync, so a user's sprint events land in a calendar named after the team instead of
// mixed into their personal primary calendar, and can be shown/hidden independently in Google
// Calendar's own UI. Replaces the earlier `GoogleCalendarConnection.calendarId` (always
// "primary") — 2026-09-11, Nave's request. `@@unique` so a second sync never creates a duplicate
// calendar for the same team.
model GoogleCalendarTeamCalendar {
  id           Int      @id @default(autoincrement())
  connectionId Int
  teamId       Int
  calendarId   String
  createdAt    DateTime @default(now())

  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  team       Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([connectionId, teamId])
}

// Maps a Sprint to the Google Calendar event created for it on one specific connection —
// a single connection can hold events for many sprints (across every team the user belongs
// to), so this can't just be a column on GoogleCalendarConnection. Looked up on
// `sprints.service.ts::update` to `events.patch` the existing event instead of recreating it.
model SprintGoogleEvent {
  id            Int      @id @default(autoincrement())
  sprintId      Int
  connectionId  Int
  googleEventId String
  createdAt     DateTime @default(now())

  sprint     Sprint                   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([sprintId, connectionId])
}

model TeamMember {
  id        Int              @id @default(autoincrement())
  userId    Int
  teamId    Int
  role      TeamRole         @default(DEVELOPER)
  isAdmin   Boolean          @default(false)
  status    TeamMemberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Feature 9 (phantom members, §9.0 decision #3): reverse side of TeamInvite.convertsMemberId —
  // normally empty/one-element (a phantom has at most one live conversion invite at a time, but
  // nothing in the schema enforces that).
  convertInvites TeamInvite[]

  @@unique([userId, teamId])
}

enum CommentType {
  KEEP
  IMPROVE
}

model Sprint {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  teamId      Int
  createdAt   DateTime  @default(now())
  // Feature 14 (product-backlog/14-sprint-and-team-deletion.md): soft delete. A non-null
  // `deletedAt` means "deleted, restorable for 30 days"; after that the purge hard-deletes the row
  // and the existing cascades remove comments / Google events / length history with it.
  deletedAt   DateTime?
  deletedById Int?

  team                 Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deletedBy            User?                @relation("SprintDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  comments             Comment[]
  googleEvents         SprintGoogleEvent[]
  lengthChanges        SprintLengthChange[]
  focusPointSelections FocusPointSprint[]
  focusPointRatings    FocusPointRating[]
  ratingClose          SprintRatingClose?
}

// Feature 5 (product-backlog/05-sprint-length-audit-log.md §5.0 decision #2): append-only audit
// log of every startDate/endDate change on a Sprint — built on the same shape as `TeamInvite`
// (FK cascade to the owning entity, FK cascade to the acting User). One baseline row is created
// alongside the Sprint itself (`previousStartDate/previousEndDate = null`); every subsequent
// `PATCH` that actually changes a date adds another row. Never updated/deleted — there is no
// mutating endpoint for this model, by design (see §5.0 decision #2).
model SprintLengthChange {
  id                Int       @id @default(autoincrement())
  sprintId          Int
  changedById       Int
  previousStartDate DateTime?
  previousEndDate   DateTime?
  newStartDate      DateTime
  newEndDate        DateTime
  reason            String?
  createdAt         DateTime  @default(now())

  sprint    Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id], onDelete: Cascade)
}

model Comment {
  id              Int         @id @default(autoincrement())
  content         String
  type            CommentType
  isAnonymous     Boolean     @default(false)
  isHighlighted   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  authorId        Int
  teamId          Int
  sprintId        Int
  // Feature 9 (phantom members, §9.0 decision #2): set only when a team admin/leader posted this
  // comment "on behalf of" `authorId` (a phantom, or a real member) — `authorId` always keeps its
  // existing meaning ("who the comment is attributed to"), this is purely who actually typed it.
  // SetNull (not Cascade) so a comment survives if the posting admin's account is later deleted.
  postedByAdminId Int?
  // Feature 3 (team comment categories, product-backlog/03-team-comment-categories.md §3.0):
  // replaces the old `category` enum field — nullable exactly like `category` was. SetNull (not
  // Cascade) so a comment never gets destroyed just because its category was disabled/removed —
  // disabling is the only supported operation on a default category (§3.0 decision #3), so in
  // practice this FK is never actually nulled by a delete, but the relation is modeled defensively
  // the same way regardless. See scripts/backfill-team-comment-categories.js for how pre-existing
  // teams' comments were migrated from the old `category` enum to this field.
  categoryId      Int?

  author              User                 @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  postedByAdmin       User?                @relation("CommentPostedByAdmin", fields: [postedByAdminId], references: [id], onDelete: SetNull)
  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprint              Sprint               @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  category            TeamCommentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  focusPointSources   FocusPointSource[]
  focusPointProposals FocusPointProposal[]
}

// Feature 20 (product-backlog/20-issue-tracking.md): improvement points tracked across sprints.
// Team-owned entities (per-team pattern, backend/AGENTS.md). Anonymity rule (§20.0 #15, #20): a
// rating / proposal keeps `userId` only to enforce "one per member"; the API never returns it, and
// it is nulled when the member leaves the team or deletes the account — the scores stay.
enum FocusPointKind {
  IMPROVE
  KEEP
}

enum FocusPointStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  MERGED
}

enum FocusPointProposalStatus {
  PENDING
  MERGED
  DISMISSED
}

enum FocusPointTaskStatus {
  OPEN
  DONE
  DROPPED
}

model FocusPoint {
  id               Int              @id @default(autoincrement())
  teamId           Int
  kind             FocusPointKind
  text             String
  status           FocusPointStatus @default(ACTIVE)
  // IMPROVE only: the starting score management sets when the point enters the pool (1-5).
  initialScore     Int?
  // "Keep watching for N more sprints" — counts only sprints with a valid rating (§20.0 #18).
  watchSprintsLeft Int?
  mergedIntoId     Int?
  createdById      Int?
  createdAt        DateTime         @default(now())
  closedAt         DateTime?

  team       Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User?                   @relation("FocusPointCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mergedInto FocusPoint?             @relation("FocusPointMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom FocusPoint[]            @relation("FocusPointMerge")
  versions   FocusPointTextVersion[]
  sources    FocusPointSource[]
  proposals  FocusPointProposal[]
  selections FocusPointSprint[]
  ratings    FocusPointRating[]
  tasks      FocusPointTask[]

  @@index([teamId, status])
}

model FocusPointTextVersion {
  id           Int      @id @default(autoincrement())
  focusPointId Int
  text         String
  changedById  Int?
  createdAt    DateTime @default(now())

  focusPoint FocusPoint @relation(fields: [focusPointId], references: [id], onDelete: Cascade)
  changedBy  User?      @relation("FocusPointTextChanger", fields: [changedById], references: [id], onDelete: SetNull)
}

model FocusPointSource {
  id           Int @id @default(autoincrement())
  focusPointId Int
  commentId    Int

  focusPoint FocusPoint @relation(fields: [focusPointId], references: [id], onDelete: Cascade)
  comment    Comment    @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([focusPointId, commentId])
}

model FocusPointProposal {
  id           Int                      @id @default(autoincrement())
  commentId    Int
  userId       Int?
  focusPointId Int?
  status       FocusPointProposalStatus @default(PENDING)
  createdAt    DateTime                 @default(now())

  comment    Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  focusPoint FocusPoint? @relation(fields: [focusPointId], references: [id], onDelete: SetNull)

  @@unique([commentId, userId])
}

model FocusPointSprint {
  id           Int      @id @default(autoincrement())
  focusPointId Int
  sprintId     Int
  selectedById Int?
  createdAt    DateTime @default(now())

  focusPoint FocusPoint @relation(fields: [focusPointId], references: [id], onDelete: Cascade)
  sprint     Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  selectedBy User?      @relation(fields: [selectedById], references: [id], onDelete: SetNull)

  @@unique([focusPointId, sprintId])
}

model FocusPointRating {
  id            Int      @id @default(autoincrement())
  focusPointId  Int
  // Nulled when the sprint is purged (feature 14) — the score history survives, `sprintEndedAt` orders it.
  sprintId      Int?
  sprintEndedAt DateTime
  userId        Int?
  score         Int
  // Optional "why". Stored with the rater but exposed by no endpoint (§20.0 #15).
  reason        String?
  updatedAt     DateTime @updatedAt

  focusPoint FocusPoint @relation(fields: [focusPointId], references: [id], onDelete: Cascade)
  sprint     Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([focusPointId, sprintId])
}

model SprintRatingClose {
  id         Int      @id @default(autoincrement())
  sprintId   Int      @unique
  closedById Int?
  closedAt   DateTime @default(now())

  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  closedBy User?  @relation(fields: [closedById], references: [id], onDelete: SetNull)
}

model FocusPointTask {
  id           Int                  @id @default(autoincrement())
  focusPointId Int
  title        String
  assigneeId   Int?
  status       FocusPointTaskStatus @default(OPEN)
  dueDate      DateTime?
  createdById  Int?
  createdAt    DateTime             @default(now())
  closedAt     DateTime?

  focusPoint FocusPoint @relation(fields: [focusPointId], references: [id], onDelete: Cascade)
  assignee   User?      @relation("FocusPointTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("FocusPointTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
}
