datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        Int                        @id @default(autoincrement())
  username                  String                     @unique
  // Feature 7 (2026-09-07, decision #3): intentionally NOT @unique anymore. Signing in with
  // Google can attach `googleId` to (or create a fresh row for) a user whose email already
  // matches another existing `User` row — that email-collision case is explicitly deferred,
  // not solved (see PRODUCT-BACKLOG.md §7.0/"לא בטיפול"), so two rows may transiently share an
  // email. Do not re-add @unique here without resolving that decision first.
  email                     String
  // Feature 7: nullable because a user created directly via Google sign-in has no password at
  // all (`password: null`), permanently and by design — not a transitional state. See
  // AuthService.login's explicit null-password guard and PRODUCT-BACKLOG.md §7.0 default #4.
  password                  String?
  // Feature 7: Google's `sub` claim — the stable identifier for "same Google account returns",
  // deliberately not relying on email comparisons alone for that (see PRODUCT-BACKLOG.md §7.0
  // default #3).
  googleId                  String?                    @unique
  // Feature 7 addendum (2026-09-11, §7.4): timestamp for "we have real external proof this
  // email belongs to this user" (Google sign-in linked/created this row with this exact
  // email) — not an enforcement/gating flag, nothing reads this to block anything. Reset to
  // null whenever the email actually changes to an address that hasn't been proven. Separate
  // from, and does not touch, the deferred email-collision decision above.
  emailVerifiedAt           DateTime?
  firstName                 String?
  lastName                  String?
  role                      String                     @default("DEVELOPER")
  // Feature 9 (phantom members, product-backlog/09-phantom-members.md §9.0 decision #1): a
  // phantom is a real `User` row (password: null, no googleId) standing in for a real person who
  // won't register. `TeamMember.userId`/`Comment.authorId` are deliberately left untouched — a
  // phantom is a `TeamMember`/comment author like any other, this flag is purely informational.
  isPhantom                 Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  createdTeams              Team[]                     @relation("TeamCreator")
  pendingApprovals          Team[]                     @relation("TeamPendingApprover")
  members                   TeamMember[]
  comments                  Comment[]                  @relation("CommentAuthor")
  commentsPostedAsAdmin     Comment[]                  @relation("CommentPostedByAdmin")
  createdInvites            TeamInvite[]
  googleCalendarConnections GoogleCalendarConnection[]
}

enum TeamRole {
  TEAM_LEADER // ראש צוות
  PRODUCT_MANAGER // מנהל מוצר
  TESTER // בודק
  DEVELOPER // מפתח
  DEVOPS // DevOps
}

enum TeamStatus {
  PENDING_APPROVAL
  ACTIVE
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

model Team {
  id                Int                          @id @default(autoincrement())
  name              String
  mainOffice        String?
  status            TeamStatus                   @default(PENDING_APPROVAL)
  createdAt         DateTime                     @default(now())
  creatorId         Int
  pendingApproverId Int?
  creator           User                         @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  pendingApprover   User?                        @relation("TeamPendingApprover", fields: [pendingApproverId], references: [id], onDelete: SetNull)
  members           TeamMember[]
  comments          Comment[]
  sprints           Sprint[]
  invites           TeamInvite[]
  googleCalendars   GoogleCalendarTeamCalendar[]
}

model TeamInvite {
  id               Int       @id @default(autoincrement())
  token            String    @unique
  teamId           Int
  name             String? // admin-facing label for a generic link, e.g. "לינק לצוות פיתוח"
  email            String? // set = personal invite locked to this address; null = generic link
  role             TeamRole  @default(DEVELOPER)
  createdById      Int
  expiresAt        DateTime?
  maxUses          Int?
  useCount         Int       @default(0)
  isRevoked        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  // Feature 9 (phantom members, §9.0 decision #3): when set, this invite is a one-time
  // phantom -> real-account conversion link, not a regular join link — consumed via a separate
  // `consumePhantomConversionInvite` flow (`invites.service.ts`), never `consumeInvite`.
  convertsMemberId Int?

  team           Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy      User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  convertsMember TeamMember? @relation(fields: [convertsMemberId], references: [id], onDelete: Cascade)
}

// Personal Google Calendar connection — one per user (not per team, see
// PRODUCT-BACKLOG.md §6.0.2). Built on the same shape as `TeamInvite`: FK cascade to the
// owning entity, a soft-revoke flag instead of a hard delete on disconnect.
model GoogleCalendarConnection {
  id                 Int      @id @default(autoincrement())
  userId             Int
  accessToken        String
  refreshToken       String
  expiresAt          DateTime
  googleAccountEmail String
  isRevoked          Boolean  @default(false)
  createdAt          DateTime @default(now())

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        SprintGoogleEvent[]
  teamCalendars GoogleCalendarTeamCalendar[]
}

// One dedicated (secondary, non-primary) Google Calendar per (connection, team) — created lazily
// on first sync, so a user's sprint events land in a calendar named after the team instead of
// mixed into their personal primary calendar, and can be shown/hidden independently in Google
// Calendar's own UI. Replaces the earlier `GoogleCalendarConnection.calendarId` (always
// "primary") — 2026-09-11, Nave's request. `@@unique` so a second sync never creates a duplicate
// calendar for the same team.
model GoogleCalendarTeamCalendar {
  id           Int      @id @default(autoincrement())
  connectionId Int
  teamId       Int
  calendarId   String
  createdAt    DateTime @default(now())

  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  team       Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([connectionId, teamId])
}

// Maps a Sprint to the Google Calendar event created for it on one specific connection —
// a single connection can hold events for many sprints (across every team the user belongs
// to), so this can't just be a column on GoogleCalendarConnection. Looked up on
// `sprints.service.ts::update` to `events.patch` the existing event instead of recreating it.
model SprintGoogleEvent {
  id            Int      @id @default(autoincrement())
  sprintId      Int
  connectionId  Int
  googleEventId String
  createdAt     DateTime @default(now())

  sprint     Sprint                   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([sprintId, connectionId])
}

model TeamMember {
  id        Int              @id @default(autoincrement())
  userId    Int
  teamId    Int
  role      TeamRole         @default(DEVELOPER)
  isAdmin   Boolean          @default(false)
  status    TeamMemberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Feature 9 (phantom members, §9.0 decision #3): reverse side of TeamInvite.convertsMemberId —
  // normally empty/one-element (a phantom has at most one live conversion invite at a time, but
  // nothing in the schema enforces that).
  convertInvites TeamInvite[]

  @@unique([userId, teamId])
}

enum CommentType {
  KEEP
  IMPROVE
}

enum CommentCategory {
  SPRINT_SETUP
  PRE_PLANNING
  PLANNING
  ONGOING_WORK
  TESTING
  AVAILABILITY
  ESTIMATIONS
  SPECIFICATIONS
  TASK_DISTRIBUTION
  PERSONAL
  FUN
  GENERAL
  TECHNICAL
}

model Sprint {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  teamId      Int
  createdAt   DateTime @default(now())

  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  comments     Comment[]
  googleEvents SprintGoogleEvent[]
}

model Comment {
  id              Int              @id @default(autoincrement())
  content         String
  type            CommentType
  category        CommentCategory?
  isAnonymous     Boolean          @default(false)
  isHighlighted   Boolean          @default(false)
  createdAt       DateTime         @default(now())
  authorId        Int
  teamId          Int
  sprintId        Int
  // Feature 9 (phantom members, §9.0 decision #2): set only when a team admin/leader posted this
  // comment "on behalf of" `authorId` (a phantom, or a real member) — `authorId` always keeps its
  // existing meaning ("who the comment is attributed to"), this is purely who actually typed it.
  // SetNull (not Cascade) so a comment survives if the posting admin's account is later deleted.
  postedByAdminId Int?

  author        User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  postedByAdmin User?  @relation("CommentPostedByAdmin", fields: [postedByAdminId], references: [id], onDelete: SetNull)
  team          Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprint        Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}
